{
  "name": "gws-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "GWS Studio with native Frame.io V4 video review",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.mjs",
    "start": "node --env-file-if-exists=.env.local server/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "user:create": "node --env-file-if-exists=.env.local scripts/create-user.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "pg": "8.16.3"
  }
}
