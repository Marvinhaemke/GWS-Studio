{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/studio.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/frameio/:path*",
      "destination": "/api/studio?__gws_path=frameio/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/studio?__gws_path=auth/:path*"
    },
    {
      "source": "/api/studio/session",
      "destination": "/api/studio?__gws_path=studio/session"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "installCommand": "npm install --no-audit --no-fund"
}
