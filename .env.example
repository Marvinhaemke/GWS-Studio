# Set Production to the final HTTPS domain. Preview can use Vercel system variables.
# Development: http://127.0.0.1:4173
APP_ORIGIN=
PORT=4173
# Connect your existing Neon database to the Vercel project to inject this value.
DATABASE_URL=
# Optional direct Neon connection for migrations; pooled DATABASE_URL is used at runtime.
DATABASE_URL_UNPOOLED=
# Independent, random values of at least 32 characters. Keep out of source control.
BETTER_AUTH_SECRET=
SESSION_SECRET=
# Optional until Frame.io is connected. Adobe OAuth Web App credentials.
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
# Must match the registered callback, on the same APP_ORIGIN.
FRAMEIO_REDIRECT_URI=
# Optional: signed Frame.io webhooks go directly to /api/frameio/webhook on Vercel.
FRAMEIO_WEBHOOK_SECRET=
