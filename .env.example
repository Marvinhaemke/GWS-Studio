# Local application origin. Use the final HTTPS origin for OAuth deployment.
APP_ORIGIN=http://127.0.0.1:4173
PORT=4173
# OAuth Web App credentials from Adobe Developer Console, Frame.io API enabled.
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
# Must exactly match the HTTPS callback registered in Adobe Developer Console.
# Example: https://your-studio.example/api/frameio/callback
FRAMEIO_REDIRECT_URI=
# At least 32 random characters; generate locally and keep out of source control.
SESSION_SECRET=
# Optional: signing secret shown once when a Frame.io webhook is created.
FRAMEIO_WEBHOOK_SECRET=
